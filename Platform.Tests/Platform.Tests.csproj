<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- серверні класи з тих самих .proto (фейкові сервіси) збігаються іменами з клієнтськими в Aggregator:
         компілятор бере локальні — це очікувано -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Platform.Aggregator\Platform.Aggregator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- фейкові gRPC-сервери для тестів Aggregator (ті самі контракти) -->
    <Protobuf Include="..\Services\Bookings\Bookings.Api\Protos\booking.proto" GrpcServices="Server" Link="Protos\booking.proto" />
    <Protobuf Include="..\Services\Catalog\Catalog.Api\Protos\catalog.proto" GrpcServices="Server" Link="Protos\catalog.proto" />
    <Protobuf Include="..\Services\Reviews\Reviews.WebApi\Protos\reviews.proto" GrpcServices="Server" Link="Protos\reviews.proto" />
  </ItemGroup>
</Project>
