{
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },
      "reviews-movie-rating": {
        "ClusterId": "reviews",
        "Order": 1,
        "Match": { "Path": "/api/movies/{movieId}/rating" }
      },
      "bookings-showtime-seats": {
        "ClusterId": "bookings",
        "Order": 1,
        "Match": { "Path": "/api/showtimes/{showtimeId}/seats" }
      },
      "bookings": {
        "ClusterId": "bookings",
        "Order": 10,
        "Match": { "Path": "/api/bookings/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "booking", "Version": "v1" }
      },
      "bookings-customers": {
        "ClusterId": "bookings",
        "Order": 10,
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "catalog-movies": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/movies/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "catalog-genres": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/genres/{**catch-all}" }
      },
      "catalog-showtimes": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/showtimes/{**catch-all}" }
      },
      "catalog-halls": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/halls/{**catch-all}" }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Order": 10,
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "reviews-discussions": {
        "ClusterId": "reviews",
        "Order": 10,
        "Match": { "Path": "/api/discussions/{**catch-all}" }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "bookings": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://bookings-api" } }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://catalog-api" } }
      },
      "reviews": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://reviews-api" } }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
