<Project Sdk="Microsoft.NET.Sdk">
  <!-- Спільні налаштування всіх сервісів платформи: Serilog, OpenTelemetry, health checks,
       service discovery, стійкість HttpClient, наскрізний CorrelationId. Не посилається на жоден проєкт. -->
  <PropertyGroup>
    <IsAspireSharedProject>true</IsAspireSharedProject>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Core.Api" Version="2.85.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.21.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>
</Project>
