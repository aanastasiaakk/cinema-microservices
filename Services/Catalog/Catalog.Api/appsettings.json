{
  "ConnectionStrings": {
    "CinemaCatalog": "Server=localhost,1433;Database=CinemaCatalog;User Id=sa;Password=Your_strong_Passw0rd;TrustServerCertificate=True;Connect Timeout=15"
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:5090",
        "Protocols": "Http1"
      },
      "grpc": {
        "Url": "http://localhost:5091",
        "Protocols": "Http2"
      }
    }
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/catalog-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
