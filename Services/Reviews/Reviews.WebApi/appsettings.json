{
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017/?maxPoolSize=50&serverSelectionTimeoutMS=5000&connectTimeoutMS=5000",
    "DatabaseName": "cinema_reviews",
    "SeedOnStartup": true,
    "CreateIndexesOnStartup": true
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:5100",
        "Protocols": "Http1"
      },
      "grpc": {
        "Url": "http://localhost:5101",
        "Protocols": "Http2"
      }
    }
  },
  "Performance": {
    "SlowRequestMs": 500
  },
  "LuckyPenny": {
    "LicenseKey": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/reviews-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
